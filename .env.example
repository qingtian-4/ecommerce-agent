# ============================================================
# Copy to .env and fill in.  .env is gitignored.
# ============================================================

# ---------- LLM (OpenAI-compatible) ----------
# DeepSeek: https://platform.deepseek.com/
ACS_LLM_PROVIDER=deepseek
ACS_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACS_LLM_BASE_URL=https://api.deepseek.com/v1
ACS_LLM_MODEL=deepseek-flash

# Optional: a cheaper/weaker model for the DIRECT + RAG routes.
# This is itself an experiment dimension for cost-aware routing
# (Research Question A). Leave empty to use ACS_LLM_MODEL everywhere.
ACS_LLM_SMALL_MODEL=

# DeepSeek enables thinking mode BY DEFAULT at effort=high. Kept off because
# thinking mode IGNORES temperature (so runs would not be deterministic) and
# because reasoning tokens are billed as output and dominate latency:
# measured 2.5x latency and 23x output tokens on a trivial router prompt.
ACS_LLM_THINKING=false
ACS_LLM_REASONING_EFFORT=high

# Ignored by the API while thinking is on -- see ACS_LLM_THINKING above.
ACS_LLM_TEMPERATURE=0.0
ACS_LLM_MAX_OUTPUT_TOKENS=1024
ACS_LLM_TIMEOUT_S=60

# Whole turn (queue + provider calls), not an estimated completion time.
# Character accounting includes JSON messages and tool schemas; not tokens.
ACS_TURN_TIMEOUT_S=120
ACS_CONTEXT_MAX_CHARS=24000
ACS_MAX_API_REQUESTS=16
ACS_MAX_TOOL_CALLS=12
ACS_MAX_RETRIEVAL_CALLS=4
# Opt-in P0 check; false restores the original runtime. No extra model requests.
# Only explicit "我想退/我要退 + order_id" plus a successful owned order read can repair.
ACS_RETURN_STATE_CHECK_ENABLED=false
# P1 pure list_orders rendering; no active task, mixed tools or eligibility conclusions.
ACS_ORDER_CANDIDATE_RENDER_ENABLED=false
# Finite persistent colour requests; rebuilt from owned user turns, no extra model call.
ACS_ORDER_CONSTRAINT_ENABLED=false
# Explicit first-turn counts only; orders, item lines and sum(quantity) stay distinct.
ACS_ORDER_AGGREGATION_ENABLED=false

# ---------- Embedding ----------
# Phase 1 uses the API provider; Phase 2 will add a local BGE-M3 backend.
ACS_EMBEDDING_PROVIDER=api
ACS_EMBEDDING_MODEL=
ACS_EMBEDDING_BASE_URL=
ACS_EMBEDDING_API_KEY=
ACS_EMBEDDING_DIM=

# ---------- Retrieval ----------
# Default selected on development evidence; dense / bm25 / hybrid are comparable modes.
# Lexical/hybrid evidence is verified by the configured LLM, not a cosine threshold.
ACS_RETRIEVAL_MODE=bm25
# 小知识库对照：retrieval | full_context | documents；默认保持按需检索。
ACS_KNOWLEDGE_MODE=retrieval
ACS_RETRIEVAL_CANDIDATE_K=10
# Verify up to candidate_k before selecting top_k; more verification tokens.
ACS_EVIDENCE_BACKFILL=false
# ---------- Reranker (SiliconFlow-compatible API) ----------
# Enable only after comparing coverage, rejection, latency and usage.
ACS_RERANKER_ENABLED=false
ACS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ACS_RERANKER_BASE_URL=https://api.siliconflow.cn/v1
# Empty reuses ACS_EMBEDDING_API_KEY only for an identical embedding base URL.
ACS_RERANKER_API_KEY=
ACS_RERANKER_TIMEOUT_S=15

# ---------- Storage ----------
ACS_DB_PATH=data/db/business.db
ACS_INDEX_DIR=data/.index
ACS_TRACE_DIR=results/traces

# ---------- Review workbench (separate from customer simulation) ----------
# Leave empty to disable admin startup. Set your own credentials in .env.
ACS_ADMIN_USERNAME=
ACS_ADMIN_PASSWORD=

# ---------- Experiment metadata (recorded into every run) ----------
ACS_EXPERIMENT_NAME=step0-smoke
ACS_SEED=42
