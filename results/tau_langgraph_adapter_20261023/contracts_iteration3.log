tmp_path = PosixPath('/tmp/pytest-of-qingtian/pytest-188/test_original_task_reference_a1')
responses = [AIMessage(content='', additional_kwargs={}, response_metadata={}, id='lc_run--01a16826-e435-74f6-8456-4a9fc2031c6f-0'...k', 'country': 'USA', 'state': 'NY', 'zip': '10108'}, 'id': '34_5', 'type': 'tool_call'}], invalid_tool_calls=[]), ...]
task_id = '34', limits = {}

    def paired_run(tmp_path, responses, task_id="33", **limits):
        rows = []
        for arm in ["old", "graph"]:
            env = get_environment()
            executed = []
            original = env.get_response
    
            def execute(call):
                executed.append(call.model_dump(mode="json"))
                return original(call)
    
            env.get_response = execute
            if arm == "old":
                model = legacy_decisions(responses)
                agent = ACSAgent(env.get_tools(), env.get_policy(), receipt_guard=True,
                                 settings=Settings(_env_file=None, max_steps=limits.get("max_model_calls", 10),
                                     max_tool_calls=limits.get("max_tool_calls", 12),
                                     context_max_chars=64000), llm_factory=lambda _: model)
            else:
                agent, model = candidate(env, tmp_path / (arm + ".sqlite"), list(responses),
                                         max_model_calls=limits.get("max_model_calls", 10),
                                         max_tool_calls=limits.get("max_tool_calls", 12))
            orchestrator = Orchestrator("retail", agent, ScriptedUser(), env, TASKS[task_id],
                                        max_steps=40, max_errors=10, timeout=30, seed=17)
            result = orchestrator.run()
            # DB-only official tasks do not require paid NL judges. ALL is unmodified.
            reward = evaluate_simulation(result, TASKS[task_id], EvaluationType.ALL,
                                         solo_mode=False, domain="retail", strict_replay=True)
            rows.append({"arm": arm, "task_id": task_id, "db": env.get_db_hash(),
                         "reward": reward.model_dump(mode="json"),
                         "executed": executed, "messages": result.messages,
                         "termination": result.termination_reason.value, "model": model,
                         "model_requests": model.calls if arm == "old" else [{
                             "messages": [_convert_message_to_dict(m) for m in messages],
                             "tools": model.bound[i],
                         } for i, messages in enumerate(model.observed)],
                         "state_note": "Official environment hash and raw receipts are authoritative"})
        if output := os.environ.get("ACS_TAU_CONTRACT_OUT"):
            path = Path(output) / (tmp_path.name + ".json")
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps([{k: ([m.model_dump(mode="json") for m in v]
                if k == "messages" else v) for k, v in row.items() if k != "model"}
                for row in rows], indent=2) + "\n")
        assert rows[0]["db"] == rows[1]["db"]
