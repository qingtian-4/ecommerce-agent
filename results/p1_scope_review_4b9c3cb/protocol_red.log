                 "| --- | --- | --- | --- | --- | --- | --- | --- | --- |"]
        labels = {"pending": "待发货", "shipped": "已发货", "delivered": "已签收",
                  "cancelled": "已取消"}
        for number, row in enumerate(rows, 1):
            values = [number, row["order_id"], row["item_id"], row["product_name"], row["sku_id"],
>                     row["color"], row["quantity"], labels.get(row["status"], row["status"]),
